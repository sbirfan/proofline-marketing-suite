{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofline.example/schemas/audit.schema.json",
  "title": "Audit Result",
  "type": "object",
  "required": [
    "schema_version",
    "score_version",
    "target_url",
    "generated_at",
    "evidence",
    "findings",
    "categories",
    "overall",
    "confidence",
    "coverage",
    "status",
    "agent_briefs",
    "agent_results",
    "agent_failures",
    "business_context",
    "context_assessment",
    "evidence_scope",
    "competitive_evidence"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "score_version": { "const": "5.0" },
    "target_url": { "type": "string", "format": "uri" },
    "generated_at": { "type": "string", "format": "date-time" },
    "evidence": { "$ref": "evidence.schema.json" },
    "findings": { "type": "array", "items": { "$ref": "finding.schema.json" } },
    "categories": {
      "type": "object",
      "required": ["content", "conversion", "seo", "competitive", "brand", "growth"],
      "properties": {
        "content": { "$ref": "score.schema.json" },
        "conversion": { "$ref": "score.schema.json" },
        "seo": { "$ref": "score.schema.json" },
        "competitive": { "$ref": "score.schema.json" },
        "brand": { "$ref": "score.schema.json" },
        "growth": { "$ref": "score.schema.json" }
      },
      "additionalProperties": false
    },
    "overall": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "enum": ["complete", "partial", "insufficient_evidence", "context_conflict"] },
    "agent_briefs": { "type": "object", "additionalProperties": { "type": "object" } },
    "agent_results": { "type": "object", "additionalProperties": { "$ref": "agent-result.schema.json" } },
    "agent_failures": { "type": "object", "additionalProperties": { "type": "string" } },
    "business_context": { "type": "object" },
    "context_assessment": {
      "type": "object",
      "required": [
        "audit_mode",
        "status",
        "observed_business_model",
        "observed_conversions",
        "supplied_conversion",
        "conflicts",
        "resolution_required"
      ],
      "properties": {
        "audit_mode": { "enum": ["current_state", "planned_funnel", "confirmed_override"] },
        "status": { "enum": ["aligned", "conflict", "unknown", "overridden"] },
        "observed_business_model": { "type": "string" },
        "observed_conversions": { "type": "array", "items": { "type": "string" } },
        "supplied_conversion": { "type": ["string", "null"] },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "resolution_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "evidence_scope": {
      "type": "object",
      "required": ["collection_scope", "represented_urls", "discovered_urls", "unrepresented_discovered_count", "unavailable_urls", "absence_claim_scope", "sitewide_claims_supported"],
      "properties": {
        "collection_scope": { "const": "single_page" },
        "represented_urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "discovered_urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "unrepresented_discovered_count": { "type": "integer", "minimum": 0 },
        "unavailable_urls": { "type": "array", "items": { "type": "object" } },
        "absence_claim_scope": { "const": "represented_pages_only" },
        "sitewide_claims_supported": { "const": false }
      },
      "additionalProperties": false
    },
    "competitive_evidence": { "type": "object", "additionalProperties": { "$ref": "evidence.schema.json" } }
  },
  "additionalProperties": false
}

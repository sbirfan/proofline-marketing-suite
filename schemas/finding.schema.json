{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofline.example/schemas/finding.schema.json",
  "title": "Audit Finding",
  "type": "object",
  "required": ["id", "category", "severity", "claim", "evidence", "confidence", "kind"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "category": { "enum": ["content", "conversion", "seo", "competitive", "brand", "growth"] },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "claim": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "source_type"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "source_type": { "type": "string" },
          "selector": { "type": ["string", "null"] },
          "observed_value": {}
        },
        "additionalProperties": false
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "recommendation": { "type": ["string", "null"] },
    "kind": { "enum": ["observed_fact", "model_interpretation", "recommendation", "estimate"] }
  },
  "additionalProperties": false
}

